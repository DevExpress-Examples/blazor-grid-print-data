@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS

<DxGrid Data="@forecasts">
    <ToolbarTemplate Context="ctx">
        <DxButton Click="() => PrintGridAsync(ctx.Grid)"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  CssClass="print-button"
                  Enabled="!Busy">
            @if(Busy) {
                <DxWaitIndicator Visible="true" />
            }
            else {
                <span>Print</span>
            }
        </DxButton>
    </ToolbarTemplate>
    <Columns>
        <DxGridDataColumn Caption="Date" FieldName="Date" />
        <DxGridDataColumn Caption="Temperature (C)" FieldName="TemperatureC" />
        <DxGridDataColumn Caption="Temperature (F)" FieldName="TemperatureF" />
        <DxGridDataColumn Caption="Summary" FieldName="Summary" />
    </Columns>
</DxGrid>

@code {
    private const string JS_PRINT_METHOD_NAME = "printGridFromStream";
    private WeatherForecast[]? forecasts;
    private readonly object lockObject = new();
    private bool busy;

    private bool Busy {
        get {
            lock(lockObject) {
                return busy;
            }
        }
        set {
            lock(lockObject) {
                busy = value;
            }
        }
    }

    private async Task PrintGridAsync(IGrid grid) {
        if(Busy)
            return;

        Busy = true;
        await Task.Yield();

        try {
            ArgumentNullException.ThrowIfNull(grid);
            using var ms = new MemoryStream();
            await grid.ExportToPdfAsync(ms);
            ms.Seek(0, SeekOrigin.Begin);
            using var streamRef = new DotNetStreamReference(ms);
            await JS.InvokeVoidAsync(JS_PRINT_METHOD_NAME, streamRef);
        }
        catch(Exception ex) {
            Console.Error.WriteLine(ex.Message);
        }
        finally {
            Busy = false;
        }
    }

    protected override void OnInitialized() {
        int rowsCount = 5000;
        DateOnly startDate = DateOnly.FromDateTime(DateTime.Now);
        string[] summaries = ["Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching"];
        forecasts = Enumerable.Range(1, rowsCount).Select(index => new WeatherForecast(
                Date: startDate.AddDays(index),
                TemperatureC: Random.Shared.Next(-20, 55),
                Summary: summaries[Random.Shared.Next(summaries.Length)]
            )).ToArray();
    }

    private record WeatherForecast(DateOnly Date, int TemperatureC, string? Summary) {
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}